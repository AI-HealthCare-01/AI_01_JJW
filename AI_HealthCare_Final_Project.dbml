// 유저 테이블 예시
Table users {
    id integer [primary key]
    username varchar
    email varchar [unique]
    created_at timestamp
}

// 게시글 테이블 예시
Table posts {
    id integer [primary key]
    title varchar
    body text [note: 'Content of the post']
    user_id integer
}

// 테이블 간 관계 설정 (외래키)
Ref: posts.user_id > users.id