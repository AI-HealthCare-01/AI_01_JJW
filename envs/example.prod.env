# 환경 설정
ENV=prod

# Redis 설정 (Docker 내부 서비스명 사용)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Docker 설정
DOCKER_USER=your_dockerhub_username
DOCKER_REPOSITORY=ai-health
APP_VERSION=v1.0.0
AI_WORKER_VERSION=v1.0.0

# Task 설정
TASK_RESULT_TTL=3600

# OAuth 설정 (실제 값으로 변경 필요 - OAUTH_SETUP_GUIDE.md 참고)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# JWT 설정 (반드시 강력한 랜덤 값으로 변경)
JWT_SECRET=your-strong-random-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256

# CORS 설정
ALLOWED_ORIGINS=["https://yourdomain.com","http://your-ec2-ip"]
